# Trigger.dev project Settings -> project reference. This is not a secret.
TRIGGER_PROJECT_REF=
# Trigger.dev production key, used only for deploying/syncing cloud secrets.
TRIGGER_SECRET_KEY=
# Fine-grained GitHub token for this repository only:
# Actions read/write, Contents read/write, Pull requests read/write.
# Used by the coordinator to dispatch workflows and by the publisher to open PRs.
BRIDGE_GITHUB_TOKEN=
# Optional. Leave blank for checks and manual review without paid AI.
# An OpenAI project API key enables the GitHub investigation job.
OPENAI_API_KEY=
